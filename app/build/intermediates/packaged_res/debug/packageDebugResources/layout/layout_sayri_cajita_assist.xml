<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#66000000">

    <!-- Circle to Search Canvas Overlay (Active when user taps Rodear para buscar) -->
    <es.inled.sayri.ui.CircleSearchOverlayView
        android:id="@+id/circleSearchOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Dismiss Background Scrim -->
    <View
        android:id="@+id/assistBackdrop"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/cajitaCard" />

    <!-- Sayri Cajita Acrylic Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cajitaCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginBottom="14dp"
        app:cardCornerRadius="26dp"
        app:cardBackgroundColor="@color/cajita_card"
        app:strokeColor="@color/cajita_border"
        app:strokeWidth="1.2dp"
        app:cardElevation="24dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="16dp">

            <!-- Cajita Top Row: Logo, Title, Live Mode Badge -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:id="@+id/ivCajitaLogo"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/sayri_logo"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:contentDescription="Sayri" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/ivCajitaLogo"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="8dp"
                    android:text="Sayri"
                    android:textColor="@color/cajita_text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <!-- Live Mode Toggle Chip -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAssistLiveMode"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="Modo Live: OFF"
                    android:textSize="11sp"
                    android:paddingHorizontal="10dp" />
            </RelativeLayout>

            <!-- Animated Siri / Sayri Orb from default UI -->
            <es.inled.sayri.ui.SayriOrbView
                android:id="@+id/assistOrb"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_marginVertical="6dp" />

            <!-- Status and transcription -->
            <TextView
                android:id="@+id/tvAssistStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿En qué puedo ayudarte?"
                android:textColor="@color/cajita_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvAssistTranscription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/cajita_text_secondary"
                android:textSize="14sp"
                android:maxLines="5"
                android:visibility="gone"
                android:layout_marginBottom="12dp" />

            <!-- Feature Action Row: Voz, Rodear para buscar, Cámara -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="12dp">

                <!-- Voice Mic Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAssistVoice"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="🎙️ Hablar"
                    android:textSize="12sp"
                    android:layout_marginEnd="6dp" />

                <!-- Circle to Search Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAssistCircleSearch"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="🔍 Rodear buscar"
                    android:textSize="12sp"
                    android:layout_marginEnd="6dp" />

                <!-- Camera Vision Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAssistCamera"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="📷 Cámara"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Input Pill Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_cajita_pill"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/sayri_logo"
                    android:contentDescription="Sayri" />

                <EditText
                    android:id="@+id/etAssistInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="@null"
                    android:hint="Pregunta o pide cualquier acción..."
                    android:textColor="@color/cajita_text_primary"
                    android:textColorHint="@color/cajita_text_muted"
                    android:textSize="14sp"
                    android:inputType="textCapSentences" />

                <ImageButton
                    android:id="@+id/btnAssistSend"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_send"
                    app:tint="@color/cajita_neon_cyan"
                    android:contentDescription="Send" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
