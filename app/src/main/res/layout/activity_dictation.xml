<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#77000000">

    <View
        android:id="@+id/dictationBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Sayri Acrylic Card with Exact Colors -->
    <es.inled.sayri.ui.CajitaCardView
        android:id="@+id/dictationCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:elevation="28dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="20dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/sayri_logo"
                    android:contentDescription="Sayri" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Sayri Dictation"
                    android:textColor="@color/cajita_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Animated Iridescent Sayri Orb -->
            <es.inled.sayri.ui.SayriOrbView
                android:id="@+id/dictationOrb"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginVertical="12dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tvDictationStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sayri is listening..."
                android:textColor="@color/cajita_text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvDictationPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/cajita_accent_cyan"
                android:textSize="14sp"
                android:minLines="2"
                android:maxLines="5"
                android:textAlignment="center"
                android:hint="Speak now..."
                android:textColorHint="@color/cajita_text_muted"
                android:layout_marginBottom="16dp" />

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:id="@+id/btnDictationCancel"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_cajita_btn"
                    android:gravity="center"
                    android:text="Cancel"
                    android:textColor="@color/cajita_text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnDictationDone"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_cajita_btn_primary"
                    android:gravity="center"
                    android:text="Done"
                    android:textColor="@color/cajita_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

        </LinearLayout>
    </es.inled.sayri.ui.CajitaCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
