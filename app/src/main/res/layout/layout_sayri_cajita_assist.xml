<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#77000000">

    <!-- Dismiss Background Scrim -->
    <View
        android:id="@+id/assistBackdrop"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/cajitaCard" />

    <!-- Sayri Desktop-Style Acrylic Card with Chroma-Ring -->
    <es.inled.sayri.ui.CajitaCardView
        android:id="@+id/cajitaCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="18dp"
        android:elevation="28dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="16dp">

            <!-- Cajita Header: Logo, Title, Controls -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:id="@+id/headerTitleLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true">

                    <ImageView
                        android:id="@+id/ivCajitaLogo"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/sayri_logo"
                        android:contentDescription="Sayri" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Sayri"
                        android:textColor="@color/cajita_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true">

                    <!-- Stop TTS Button (Visible when speaking) -->
                    <TextView
                        android:id="@+id/btnAssistStopTts"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_cajita_btn_primary"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:layout_marginEnd="6dp"
                        android:text="Stop Audio"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- Live Mode Toggle Chip -->
                    <TextView
                        android:id="@+id/btnAssistLiveMode"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_cajita_btn"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:text="Live: OFF"
                        android:textColor="@color/cajita_text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />

                    <ImageView
                        android:id="@+id/btnAssistClose"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="8dp"
                        android:padding="4dp"
                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                        app:tint="@color/cajita_text_secondary"
                        android:contentDescription="Close" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Large User Query (Prominent) -->
            <TextView
                android:id="@+id/tvAssistStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="How can I help you?"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- Large Assistant Response in MaxHeightScrollView with internal scrolling -->
            <es.inled.sayri.ui.MaxHeightScrollView
                android:id="@+id/scrollAssistResponse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="vertical"
                android:fadeScrollbars="false"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvAssistTranscription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#E2E8F0"
                    android:textSize="16.5sp"
                    android:lineSpacingExtra="4dp"
                    android:textIsSelectable="true"
                    android:visibility="gone" />
            </es.inled.sayri.ui.MaxHeightScrollView>

            <!-- Feature Action Row: Voice, Circle to Search, Camera -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="12dp">

                <!-- Voice Mic Button -->
                <TextView
                    android:id="@+id/btnAssistVoice"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_cajita_btn"
                    android:gravity="center"
                    android:text="Voice"
                    android:textColor="@color/cajita_text_primary"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Circle to Search Button -->
                <TextView
                    android:id="@+id/btnAssistCircleSearch"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1.4"
                    android:background="@drawable/bg_cajita_btn"
                    android:gravity="center"
                    android:text="Circle to Search"
                    android:textColor="@color/cajita_text_primary"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Camera Vision Button -->
                <TextView
                    android:id="@+id/btnAssistCamera"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_cajita_btn"
                    android:gravity="center"
                    android:text="Camera"
                    android:textColor="@color/cajita_text_primary"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- Cajita Top Input Pill Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_cajita_pill"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/sayri_logo"
                    android:contentDescription="Sayri" />

                <EditText
                    android:id="@+id/etAssistInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="@null"
                    android:hint="Ask or say anything..."
                    android:textColor="@color/cajita_text_primary"
                    android:textColorHint="@color/cajita_text_muted"
                    android:textSize="13.5sp"
                    android:imeOptions="actionSend"
                    android:inputType="textCapSentences" />

                <ImageButton
                    android:id="@+id/btnAssistSend"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_send"
                    app:tint="@color/cajita_accent_cyan"
                    android:contentDescription="Send" />
            </LinearLayout>

        </LinearLayout>
    </es.inled.sayri.ui.CajitaCardView>

    <!-- Circle to Search Canvas Overlay (Brought to front over everything when active) -->
    <es.inled.sayri.ui.CircleSearchOverlayView
        android:id="@+id/circleSearchOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="40dp"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>
